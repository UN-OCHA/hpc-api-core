{
  "name": "@unocha/hpc-api-core",
  "version": "14.3.0",
  "description": "Core libraries supporting HPC.Tools API Backend",
  "license": "Apache-2.0",
  "private": false,
  "scripts": {
    "check-types": "tsc --noEmit",
    "prepare": "[ -d .git ] && git config blame.ignoreRevsFile .git-blame-ignore-revs; husky",
    "reinstall": "rm -rf node_modules/ && yarn",
    "lint-prettier": "prettier -c .",
    "lint-eslint": "eslint --quiet .",
    "lint": "yarn lint-prettier && yarn lint-eslint"
  },
  "engines": {
    "node": ">=20.19.0 || >=22.14.0",
    "npm": ">=9.6.5 || >=10.9.0 || >=11.3.0",
    "yarn": ">=1.22.22"
  },
  "dependencies": {
    "@types/lodash": "^4.17.20",
    "fp-ts": "^2.14.0",
    "io-ts": "2.2.20",
    "knex": "3.1.0",
    "lodash": "^4.17.21",
    "pg": "^8.16.3",
    "ts-node": "^10.9.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.10",
    "@types/pg": "^8.15.4",
    "@unocha/hpc-repo-tools": "^7.1.1",
    "eslint": "^9.30.1",
    "husky": "^9.1.7",
    "jest": "^30.0.3",
    "lint-staged": "^16.1.2",
    "prettier": "3.6.2",
    "ts-jest": "^29.4.0",
    "typescript": "^5.8.3"
  },
  "lint-staged": {
    "*.{ts,js,cjs,mjs}": "eslint --cache",
    "*.{js,cjs,mjs,ts,md,json,yml,yaml,sh}": "prettier --check"
  }
}
