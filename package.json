{
  "name": "@unocha/hpc-api-core",
  "version": "11.1.0",
  "description": "Core libraries supporting HPC.Tools API Backend",
  "license": "Apache-2.0",
  "private": false,
  "scripts": {
    "check-types": "tsc --noEmit",
    "prepare": "[ -d .git ] && git config blame.ignoreRevsFile .git-blame-ignore-revs; husky",
    "reinstall": "rm -rf node_modules/ && yarn",
    "lint-prettier": "prettier -c .",
    "lint-eslint": "eslint --quiet .",
    "lint": "yarn lint-prettier && yarn lint-eslint"
  },
  "engines": {
    "node": ">=20.15.1",
    "yarn": ">=1.22.22"
  },
  "dependencies": {
    "@types/lodash": "^4.17.16",
    "@types/node-fetch": "2.6.11",
    "fp-ts": "^2.14.0",
    "io-ts": "2.2.20",
    "knex": "3.1.0",
    "lodash": "^4.17.21",
    "node-fetch": "2.7.0",
    "pg": "^8.14.1",
    "ts-node": "^10.9.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.16",
    "@types/pg": "^8.11.11",
    "@unocha/hpc-repo-tools": "^6.0.0",
    "eslint": "^9.21.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^15.4.3",
    "prettier": "3.5.3",
    "ts-jest": "^29.2.6",
    "typescript": "^5.8.2"
  },
  "lint-staged": {
    "*.{ts,js,cjs,mjs}": [
      "prettier --check",
      "eslint"
    ],
    "*.{js,cjs,mjs,ts,md,json,yml,yaml}": "prettier --check"
  }
}
