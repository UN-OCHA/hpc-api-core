{
  "name": "@unocha/hpc-api-core",
  "version": "15.1.3",
  "description": "Core libraries supporting HPC.Tools API Backend",
  "license": "Apache-2.0",
  "private": false,
  "scripts": {
    "check-types": "tsc --noEmit",
    "prepare": "[ -d .git ] && git config blame.ignoreRevsFile .git-blame-ignore-revs; husky",
    "reinstall": "rm -rf node_modules/ && yarn",
    "lint-prettier": "prettier -c .",
    "lint-eslint": "eslint --quiet .",
    "lint": "yarn lint-prettier && yarn lint-eslint"
  },
  "engines": {
    "node": ">=22.18.0",
    "npm": ">=10.9.3 || >=11.5.0",
    "yarn": ">=1.22.22"
  },
  "dependencies": {
    "@types/lodash": "^4.17.20",
    "fp-ts": "2.16.10",
    "io-ts": "2.2.22",
    "knex": "3.1.0",
    "lodash": "^4.17.21",
    "pg": "^8.16.3",
    "ts-node": "^10.9.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.6.1",
    "@types/pg": "^8.15.5",
    "@unocha/hpc-repo-tools": "^8.0.0",
    "eslint": "^9.36.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^16.2.3",
    "prettier": "3.6.2",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{ts,js,cjs,mjs}": "eslint --cache",
    "*.{js,cjs,mjs,ts,md,json,yml,yaml,sh}": "prettier --check"
  }
}
